{
  "name": "develop-boards",
  "main": "_worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {
    "command": "node scripts/cf-build.js"
  },
  "assets": {
    "directory": "./dist-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "SHR_BUCKET",
      "bucket_name": "develop-boards"
    }
  ]
}
