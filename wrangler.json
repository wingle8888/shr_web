{
  "name": "develop-boards",
  "main": "_worker.js",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {
    "command": "node scripts/cf-build.js"
  },
  "assets": {
    "directory": "./dist-assets",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CATALOG",
        "class_name": "CatalogDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CatalogDO"]
    }
  ]
}
